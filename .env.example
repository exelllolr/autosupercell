# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# AI Provider Configuration
AI_PROVIDER=openai  # Options: openai, claude, gemini

# OpenAI API (for AI product search)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API (alternative to OpenAI, cheaper)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API (cheapest option)
GEMINI_API_KEY=your_gemini_api_key_here

# Supercell Store URLs
SUPERCELL_STORE_URL=https://store.supercell.com
CLASH_ROYALE_STORE_URL=https://store.supercell.com/clash-royale
BRAWL_STARS_STORE_URL=https://store.supercell.com/brawl-stars

# Browser (обход блокировки «unusual activity»)
BROWSER_HEADLESS=true
BROWSER_USE_CHROME=false
BROWSER_WARMUP=true
BROWSER_USE_PERSISTENT_PROFILE=true
BROWSER_PROFILE_DIR=browser_profile
# Использовать профиль установленного Chrome (тот же, где ты заходишь вручную). Перед запуском закрой Chrome
BROWSER_USE_SYSTEM_PROFILE=false
BROWSER_WARMUP_VISIT_SUPERCELL=true
BROWSER_USE_STEALTH_PLUGIN=true
# Patchright (undetected Playwright): pip install patchright && patchright install chrome, затем BROWSER_USE_PATCHRIGHT=true
BROWSER_USE_PATCHRIGHT=false
# Запись видео сессии (videos/). Работает только при BROWSER_USE_PERSISTENT_PROFILE=false
BROWSER_RECORD_VIDEO=true
# Режим инкогнито (может помочь при блокировках)
BROWSER_INCOGNITO=false
# Режим инкогнито — без сохранённых аккаунтов и cookies
# reCAPTCHA: ключ 2Captcha для обхода блокировки Supercell (опционально, платно)
# Купить: https://2captcha.com — затем указать API ключ
# CAPTCHA_2CAPTCHA_API_KEY=your_2captcha_api_key

# Proxy Configuration
PROXY_ENABLED=true
PROXY_ROTATION_ENABLED=true
PROXY_LIST_FILE=proxies.txt
# Всегда использовать только первый прокси из proxies.txt (если рабочий один)
PROXY_USE_FIRST_ONLY=false

# Novada proxy (резидентные/датацентр) — для GoLogin и обычного браузера используются только свои прокси
NOVADA_ENABLED=false
NOVADA_ROTATING=false
NOVADA_USERNAME=
NOVADA_API_KEY=
NOVADA_ZONE=res
NOVADA_REGION=us
NOVADA_STATE=
NOVADA_CITY=
NOVADA_PROXY_HOST=super.novada.pro
NOVADA_PROXY_PORT=7777
NOVADA_STICKY_MINUTES=0

# Supercell ID: задержки (сек) перед и после LOG IN — снижают «unusual activity», дают время загрузиться форме кода
# SUPERCELL_LOGIN_DELAY_BEFORE_SUBMIT=5
# SUPERCELL_LOGIN_DELAY_AFTER_SUBMIT=8

# Payment Configuration
GOOGLE_PAY_ENABLED=true
PAYMENT_TIMEOUT=120

# External Services
PLATI_API_KEY=your_plati_api_key
PLATI_API_URL=https://plati.io/api

KUPIKOD_WEBHOOK_SECRET=your_kupikod_webhook_secret
KUPIKOD_API_URL=https://kupikod.ru/api

FUNPAY_API_KEY=your_funpay_api_key
FUNPAY_API_URL=https://funpay.com/api

AVITO_API_KEY=your_avito_api_key
AVITO_API_URL=https://api.avito.ru

# Security
ENCRYPTION_KEY=your_32_byte_encryption_key_here
SESSION_TIMEOUT=3600

# Monitoring
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/autosupercell.log

# Order Configuration
MAX_ORDER_TTL=600
TARGET_ORDER_TTL=120
MAX_RETRIES=3

# GoLogin anti-detect browser
GOLOGIN_API_TOKEN=
GOLOGIN_PROFILE_ID=
